{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run ND Finance Web",
			"type": "shell",
			"command": "${workspaceFolder}\\start-nd-finance.bat",
			"args": [],
			"isBackground": true,
			"problemMatcher": {
				"base": "$msCompile",
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*$",
					"endsPattern": "^(.*Now listening on: http://localhost:5080.*|ND Finance READY: http://localhost:5080/)$"
				}
			},
			"runOptions": {
				"runOn": "folderOpen"
			}
		}
	]
}